{
  "schemaVersion": 1,
  "id": "copyshopkeepers",
  "version": "${version}",
  "name": "CopyShopKeepers",
  "description": "Exports the open merchant's trades (villager / ShopKeepers) to your clipboard as a ready-to-paste ShopKeepers YAML fragment, a readable list, or full JSON.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "pl.fejzu.copyshopkeepers.client.FabricModDataGenerator"
    ],
    "client": [
      "pl.fejzu.copyshopkeepers.client.FabricModClient"
    ],
    "main": [
      "pl.fejzu.copyshopkeepers.FabricMod"
    ]
  },
  "mixins": [
    "copyshopkeepers.mixins.json",
    {
      "config": "copyshopkeepers.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
